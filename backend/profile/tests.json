{
  "tests": [
    {
      "name": "CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Без токена",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "Неверный токен",
      "method": "GET",
      "path": "/",
      "headers": {
        "X-Auth-Token": "abcdef"
      },
      "expectedStatus": 401
    },
    {
      "name": "Список статей",
      "method": "GET",
      "path": "/?resource=articles",
      "expectedStatus": 200
    },
    {
      "name": "Создание статьи без прав",
      "method": "POST",
      "path": "/?resource=articles",
      "body": {
        "action": "create"
      },
      "expectedStatus": 403
    },
    {
      "name": "Рубрики",
      "method": "GET",
      "path": "/?resource=articles&categories=1",
      "expectedStatus": 200
    },
    {
      "name": "Рубрика без прав",
      "method": "POST",
      "path": "/?resource=articles",
      "body": {
        "action": "category-save",
        "name": "Тест"
      },
      "expectedStatus": 403
    },
    {
      "name": "Блоки главной",
      "method": "GET",
      "path": "/?resource=blocks",
      "expectedStatus": 200
    },
    {
      "name": "Блок без прав",
      "method": "POST",
      "path": "/?resource=blocks",
      "body": {
        "action": "save",
        "leftText": "Тест"
      },
      "expectedStatus": 403
    },
    {
      "name": "Онлайн",
      "method": "GET",
      "path": "/?resource=users",
      "expectedStatus": 200
    },
    {
      "name": "Список юзеров без прав",
      "method": "GET",
      "path": "/?resource=users&admin=1",
      "expectedStatus": 403
    },
    {
      "name": "Смена статуса без прав",
      "method": "POST",
      "path": "/?resource=users",
      "body": {
        "action": "set-status",
        "userId": 1,
        "level": 6
      },
      "expectedStatus": 403
    },
    {
      "name": "Рейтинг",
      "method": "GET",
      "path": "/?resource=users&rating=1",
      "expectedStatus": 200
    },
    {
      "name": "Реакции",
      "method": "GET",
      "path": "/?resource=reactions&ids=abcdef123456",
      "expectedStatus": 200
    },
    {
      "name": "Лайк без входа",
      "method": "POST",
      "path": "/?resource=reactions",
      "body": {
        "newsId": "abcdef123456",
        "value": 1
      },
      "expectedStatus": 401
    },
    {
      "name": "Топ новостей",
      "method": "GET",
      "path": "/?resource=reactions&top=1",
      "expectedStatus": 200
    },
    {
      "name": "Удаление без прав",
      "method": "POST",
      "path": "/?resource=users",
      "body": {
        "action": "delete-user",
        "userId": 999999
      },
      "expectedStatus": 403
    },
    {
      "name": "Создание бота без прав",
      "method": "POST",
      "path": "/?resource=users",
      "body": {
        "action": "create-bot",
        "name": "Тест",
        "level": 1
      },
      "expectedStatus": 403
    }
  ]
}