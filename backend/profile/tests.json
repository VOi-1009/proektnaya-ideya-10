          {
            "text": "Да"
          },
          {
            "text": "Нет"
          }
        ]
      },
      "expectedStatus": 403
    },
    {
      "name": "Голос без входа",
      "method": "POST",
      "path": "/?resource=polls",
      "body": {
        "action": "vote",
        "pollId": 1,
        "optionId": 1
