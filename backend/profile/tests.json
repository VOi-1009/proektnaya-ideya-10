{
  "tests": [
    {
      "name": "CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Без токена",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "Неверный токен",
      "method": "GET",
      "path": "/",
      "headers": {
        "X-Auth-Token": "abcdef"
      },
      "expectedStatus": 401
    },
    {
      "name": "Список статей",
      "method": "GET",
      "path": "/?resource=articles",
      "expectedStatus": 200
    },
    {
      "name": "Создание статьи без прав",
      "method": "POST",
      "path": "/?resource=articles",
      "body": {
        "action": "create"
      },
      "expectedStatus": 403
    },
    {
      "name": "Рубрики",
      "method": "GET",
      "path": "/?resource=articles&categories=1",
      "expectedStatus": 200
    },
    {
      "name": "Рубрика без прав",
      "method": "POST",
      "path": "/?resource=articles",
      "body": {
        "action": "category-save",
        "name": "Тест"
      },
      "expectedStatus": 403
    },
    {
      "name": "Онлайн",
      "method": "GET",
      "path": "/?resource=users",
      "expectedStatus": 200
    },
    {
      "name": "Список юзеров без прав",
      "method": "GET",
      "path": "/?resource=users&admin=1",
      "expectedStatus": 403
    },
    {
      "name": "Смена статуса без прав",
      "method": "POST",
      "path": "/?resource=users",
      "body": {
        "action": "set-status",
        "userId": 1,
        "level": 6
      },
      "expectedStatus": 403
    }
  ]
}