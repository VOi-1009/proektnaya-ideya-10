{
  "tests": [
    {
      "name": "CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Без токена",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "Неизвестная монета без входа",
      "method": "GET",
      "path": "/?action=candles&coinId=nope&interval=1h",
      "expectedStatus": 401
    },
    {
      "name": "Проверка без ключа",
      "method": "GET",
      "path": "/?action=tick",
      "expectedStatus": 403
    },
    {
      "name": "Рейтинг без входа закрыт",
      "method": "GET",
      "path": "/?action=leaderboard",
      "expectedStatus": 401
    },
    {
      "name": "Свечи без входа закрыты",
      "method": "GET",
      "path": "/?action=candles&coinId=bitcoin&interval=1h",
      "expectedStatus": 401
    },
    {
      "name": "Сделки без входа закрыты",
      "method": "GET",
      "path": "/?action=trades&userId=2",
      "expectedStatus": 401
    },
    {
      "name": "Список турниров открыт",
      "method": "GET",
      "path": "/?action=tournaments",
      "expectedStatus": 200
    },
    {
      "name": "Условия «Приведи друга» открыты",
      "method": "GET",
      "path": "/?action=referral_info",
      "expectedStatus": 200
    },
    {
      "name": "Свои друзья без входа закрыты",
      "method": "GET",
      "path": "/?action=referral_me",
      "expectedStatus": 401
    },
    {
      "name": "Админка рефералов без входа",
      "method": "GET",
      "path": "/?action=referral_admin",
      "expectedStatus": 401
    },
    {
      "name": "Админка турниров без входа",
      "method": "GET",
      "path": "/?action=tournament_admin",
      "expectedStatus": 401
    },
    {
      "name": "Участие в турнире без входа",
      "method": "POST",
      "path": "/",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "action": "tournament_join",
        "id": 1
      },
      "expectedStatus": 401
    },
    {
      "name": "Новые монеты открыты",
      "method": "GET",
      "path": "/?action=listings",
      "expectedStatus": 200
    },
    {
      "name": "Стакан несуществующей монеты",
      "method": "GET",
      "path": "/?action=listing_book&slug=x-nope",
      "expectedStatus": 404
    },
    {
      "name": "График несуществующей монеты",
      "method": "GET",
      "path": "/?action=listing_chart&slug=x-nope",
      "expectedStatus": 404
    },
    {
      "name": "Админка листинга без входа",
      "method": "GET",
      "path": "/?action=listing_admin",
      "expectedStatus": 401
    },
    {
      "name": "Создание монеты без входа",
      "method": "POST",
      "path": "/",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "action": "listing_save",
        "name": "Test",
        "symbol": "TST",
        "startPrice": 1
      },
      "expectedStatus": 401
    }
  ]
}